{:dataset/id "hirameki-patents"
 :dataset/category :public-patent-bibliographic-corpus
 :dataset/owner "https://github.com/cloud-itonami/hirameki"
 :dataset/format :kotoba-edn
 :dataset/substrate :git
 :dataset/adr ["2606212200" "2605241500" "2607251552"]
 :dataset/sourcing :authoritative
 :dataset/person-level-data false

 ;; Where the rows come from. The citation-graph harvest is the one that
 ;; actually runs; the bulk legs remain operator steps and are marked as such
 ;; rather than described as if they had run.
 :dataset/sources
 [{:id :google-patents
   :status :running
   :auth :none
   :via "cloud-itonami/hirameki (harvest leg) using kotoba-lang/toshokan-patents"
   :note "citation-graph walk; bibliographic metadata only, no CPC"}
  {:id :uspto-odp
   :status :operator-step-not-yet-run
   :auth "USPTO_ODP_API_KEY (free, the operator's — never committed)"
   :note "adds CPC classification, which is what field-level analytics need"}
  {:id :epo-ops    :status :not-implemented :auth "OAuth registration"}
  {:id :wipo-patentscope :status :not-implemented :auth :none}]

 :dataset/artifacts
 {:journal "80-data/public/google-patents.journal.edn"
  :corpus "corpus/*.kotoba.edn"
  :datoms "datoms/*.kotoba.edn"
  :provenance "ingest-provenance.edn"
  :publication "publish-manifest.edn"}

 ;; Every published shard stays under the 256 KiB IPFS chunker limit, so a
 ;; CIDv1/raw CID is exactly what `ipfs add --cid-version=1 --raw-leaves`
 ;; produces and `clojure -M verify.clj` can check it with no daemon.
 :dataset/shard-limit-bytes 262144

 ;; 実測 2026-08-10。**宣言と実体を分けて書く。**
 ;; `datalad create` は使い捨ての clone で走らせたので、そこで初期化された annex は
 ;; その clone の .git/config にしか無く、push されていない。commit されているのは
 ;; **宣言**（.datalad/config と .gitattributes の振り分け規則）であって substrate ではない。
 :dataset/annex {:declared true
                 :initialized-in-this-repo false
                 :annexed-files 0
                 :routing "*.edn → git; *.tsv, *.tsv.zip, *.raw.edn → annex"
                 :content-remote :none}

 ;; 保管の実態。**耐久コピーは 1 つ**で、これがこの dataset の最大の穴。
 :dataset/custody
 {:durable-copies 2
  :github "cloud-itonami/hirameki-patents（git、EDN）"
  :b2 {:bucket "gftdcojp-m365-annex"
       :prefix "hirameki-patents/"
       :form :git-bundle
       :schedule "com.gftd.hirameki-mirror（日次 03:53）"
       :generations 8
       :pointer "latest.edn"
       :note "annex ではなく bundle。780 KB の EDN は git が得意な領域で、annex 化すると
正本に対する git diff / git blame を失って何も得ない。足りないのは content-addressed
store ではなく 2 人目の custodian。**bundle は annex より強い性質を 1 つ持つ** ——
GitHub が消えても bundle 1 つから repo 全体が復元できる（annex は実体を持つが履歴を持たない）。"}
  :local-checkouts 2
  :ipfs {:cids-computed true :pinned false
         :note "CID は検証できるが取得できない。gateway は何も返さない（実測 2026-08-10）"}
  :radicle {:rid "rad:z3yMT2MUPS4PwTekwt3wboCAyRxm1" :replica-on-this-node false
            :note "west には 3,615 repo が rid を持つがローカル storage は 17 件、
node は inbound を待ち受けない設定。第 2 の custodian にするには Radicle 運用の立ち上げが要る。"}
  :numcopies 2
  :fsck-schedule :none
  ;; **毎回のミラーが復元ドリルを兼ねる。** 置いたあと B2 から取り直し →
  ;; sha256 一致 → clone → HEAD 一致 → verify.clj 通過、まで確かめて初めて成功と呼ぶ。
  ;; 復元したことのないバックアップはバックアップではなく、バックアップの主張である。
  :recovery-drill {:runs-every-mirror true
                   :first-verified "2026-08-10"
                   :checks [:sha256 :git-clone :head-match :corpus-verify]
                   :note "`git bundle verify` は末尾に 1 バイト足した bundle を**通した**（実測）。
sha256 比較と clone が捕まえている。単独の検査に頼らないこと。"}}}
